# CQ 2: Which compute targets support GPU for inference, and for which mode (real-time or batch)?
# Approach: has_gpu_support, plus any assertion about a compute target mentioning GPU.
#
# Every query starts from assertion nodes (selective, and fast in Oxigraph),
# so negation and conditions stay visible. No ORDER BY: results are sorted
# by `ckg evaluate`.
PREFIX ckg:  <https://example.org/ckg/>
PREFIX ckgd: <https://example.org/ckg/domain/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX v:    <https://example.org/ckg/vocab/>

SELECT DISTINCT ?subject ?predicate ?object ?value ?negated ?conditionType ?conditionValue
WHERE {
  ?a ckg:predicate ?p ;
     ckg:subject ?s ;
     ckg:negated ?negated .
  ?s skos:prefLabel ?subject .
  OPTIONAL { ?a ckg:object ?o . ?o skos:prefLabel ?object . }
  OPTIONAL { ?a ckg:object_value ?value . }
  OPTIONAL { ?a ckg:conditions ?c . ?c ckg:type ?conditionType ; ckg:value ?conditionValue . }
  FILTER (?p = ckgd:has_gpu_support || (EXISTS { ?s a ckgd:ComputeTarget } && CONTAINS(LCASE(STR(?object)), "gpu")))
  BIND (STRAFTER(STR(?p), STR(ckgd:)) AS ?predicate)
}
